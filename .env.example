# Copy to `.env` if `scripts/dev-local.sh` fails with Postgres auth (local Postgres password often is not Onyx’s default `password`).
POSTGRES_PASSWORD=postgres
# Background jobs: dev-local.sh skips Celery/beat by default. Set DEV_SKIP_BG=0 to run them; with workers on, optional DEV_BG_MINIMAL=1 or DEV_BG_WORKERS=primary,beat,light
# OpenSearch: local Docker uses HTTP; HTTPS managed endpoints need OPENSEARCH_USE_SSL=true when not auto-detected from OPENSEARCH_HOST.
